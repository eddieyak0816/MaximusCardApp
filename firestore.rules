rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Staff: read/write allowed for signed-in clients (PIN auth via anonymous sign-in)
    match /staff/{doc=**} {
      allow read, write: if request.auth != null;
    }

    // App collections: signed-in clients can read/write
    match /customers/{doc=**} {
      allow read, write: if request.auth != null;
    }
    match /cards/{doc=**} {
      allow read, write: if request.auth != null;
    }
    match /transactions/{doc=**} {
      allow read, write: if request.auth != null;
    }

    // Deny anything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}